# Arcade product/pattern API (studio.arcade.ai)
ARCADE_API_KEY=
# Meshy: 2D character images and 3D twins
MESHY_API_KEY=

# Turso (libSQL). Leave empty locally to use .data/pawprint.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob (private). Leave empty locally to store files in .data/blobs
BLOB_READ_WRITE_TOKEN=

# Demo access: PAWPRINT_DEMO_OPEN=1 lets anyone in, or set a passcode
PAWPRINT_DEMO_OPEN=
PAWPRINT_DEMO_PASSCODE=
# Vercel cron auth for /api/maintenance/cleanup
CRON_SECRET=
PHOTO_RETENTION_DAYS=
